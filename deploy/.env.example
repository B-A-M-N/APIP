# APIP deployment secrets — example only. Copy to .env and fill with your
# OWN generated values; never ship or commit real secrets, never reuse these.
#
# Every *_FILE variant reads the secret from a file mounted into the
# container (secrets injected at runtime), which is the preferred mechanism.

# Operator bearer token the CLI/API require. Generate with:
#   openssl rand -hex 32
APIP_OPERATOR_TOKEN=

# PostgreSQL superuser + app credentials (used by compose to init the DB).
POSTGRES_USER=apip
POSTGRES_PASSWORD=
POSTGRES_DB=apip

# Database password the controller uses (must match POSTGRES_PASSWORD).
# Provide via APIP_DB_PASSWORD_FILE in the container or APIP_DB_PASSWORD.
APIP_DB_PASSWORD_FILE=/run/secrets/apip_db_password

# High-entropy secret for derived keys / pseudonymization. Generate with:
#   openssl rand -hex 32
APIP_SECRET_KEY=

# Controller API base the CLI talks to.
APIP_BASE=http://127.0.0.1:8510