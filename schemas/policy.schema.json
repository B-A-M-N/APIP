{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apip.invalid/schemas/policy.schema.json",
  "title": "APIP Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "mode", "scope", "thresholds", "limits", "safety"],
  "properties": {
    "policy_version": {"type": "string", "minLength": 1},
    "mode": {"enum": ["OFF", "OBSERVE", "SHADOW", "ENFORCE", "EMERGENCY"]},
    "scope": {"type": "string", "minLength": 1},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observe_m", "fqdn_auto_m", "fqdn_auto_s", "ip_rate_m", "ip_rate_s", "ip_deny_m", "ip_deny_s"],
      "properties": {
        "observe_m": {"type": "integer", "minimum": 0, "maximum": 100},
        "fqdn_auto_m": {"type": "integer", "minimum": 0, "maximum": 100},
        "fqdn_auto_s": {"type": "integer", "minimum": 0, "maximum": 100},
        "ip_rate_m": {"type": "integer", "minimum": 0, "maximum": 100},
        "ip_rate_s": {"type": "integer", "minimum": 0, "maximum": 100},
        "ip_deny_m": {"type": "integer", "minimum": 0, "maximum": 100},
        "ip_deny_s": {"type": "integer", "minimum": 0, "maximum": 100},
        "rungs": {
          "type": "object",
          "description": "Per-rung automation floors (docs/25). Monotonicity (higher rung => floors at least as strict) must be validated by the policy linter.",
          "additionalProperties": false,
          "properties": {
            "L1": {"$ref": "#/$defs/rungFloor"},
            "L2": {"$ref": "#/$defs/rungFloor"},
            "L4": {"$ref": "#/$defs/rungFloor"},
            "L5": {"$ref": "#/$defs/rungFloor"}
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_auto_ttl_seconds"],
      "properties": {
        "max_auto_ttl_seconds": {"type": "integer", "minimum": 1},
        "max_actions_per_bundle": {"type": "integer", "minimum": 1},
        "max_auto_actions_per_tenant_window": {"type": "integer", "minimum": 1},
        "max_challenged_transaction_fraction_per_hour": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "L1 client-impact budget (docs/25)."
        },
        "max_segment_denied_volume_alarm_per_hour": {
          "type": "integer",
          "minimum": 1,
          "description": "Allow-first segment denial alarm threshold (docs/26)."
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_prefix_deny", "auto_routing", "auto_wildcard_domain"],
      "properties": {
        "auto_prefix_deny": {"const": false},
        "auto_routing": {"const": false},
        "auto_wildcard_domain": {"type": "boolean"},
        "allowlist_precedence": {"type": "boolean"},
        "require_expiry": {"type": "boolean"},
        "no_ai_components": {
          "const": true,
          "description": "No-AI invariant flag (docs/28): platform must operate with zero AI/ML/LLM components."
        }
      }
    },
    "behavioral": {
      "type": "object",
      "description": "Behavioral suite policy (docs/23).",
      "additionalProperties": false,
      "properties": {
        "enabled_families": {
          "type": "array",
          "items": {"type": "string", "enum": [
            "beacon_periodicity", "dga_likelihood", "dns_tunneling",
            "fastflux", "volume_anomaly", "first_seen_novelty",
            "tls_metadata_mismatch", "sync_first_contact"
          ]},
          "uniqueItems": true
        },
        "corroboration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distinct_families_for_rate_limit", "distinct_families_for_deny"],
          "properties": {
            "distinct_families_for_rate_limit": {"type": "integer", "minimum": 2},
            "distinct_families_for_deny": {"type": "integer", "minimum": 3},
            "deny_also_requires_external": {"type": "boolean"}
          }
        },
        "max_behavioral_m_contribution": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60,
          "description": "Cap on combined behavioral contribution to M; keeps behavioral evidence below deny floors on its own."
        }
      }
    },
    "segments": {
      "type": "object",
      "description": "Allow-first segment policies (docs/26), keyed by segment id.",
      "additionalProperties": {"$ref": "#/$defs/segmentPolicy"}
    },
    "randomization": {
      "type": "object",
      "description": "Seeded randomization bounds (docs/29). Bounds are policy; draws are recorded per decision.",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "bounds_version": {"type": "string", "minLength": 1},
        "mechanisms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "challenge_sampling": {"$ref": "#/$defs/randBounds"},
            "rate_ceiling": {"$ref": "#/$defs/randBounds"},
            "ttl_jitter": {"$ref": "#/$defs/randBounds"},
            "shadow_review_sampling": {"$ref": "#/$defs/randBounds"},
            "threshold_dither": {"$ref": "#/$defs/randBounds"}
          }
        }
      }
    }
  },
  "$defs": {
    "rungFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m", "s"],
      "properties": {
        "m": {"type": "integer", "minimum": 0, "maximum": 100},
        "s": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "randBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "units": {"type": "string"}
      }
    },
    "segmentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "onboarding_stage"],
      "properties": {
        "mode": {"enum": ["ALLOW_FIRST", "STANDARD"]},
        "onboarding_stage": {"enum": ["ENUMERATE", "SIMULATE", "SHADOW", "CANARY", "ENFORCE", "REVIEW"]},
        "owner": {"type": "string"},
        "review_cadence_days": {"type": "integer", "minimum": 1},
        "allowlist_ttl_days": {"type": "integer", "minimum": 1},
        "max_denied_volume_alarm_per_hour": {"type": "integer", "minimum": 1},
        "break_glass_profile": {"type": "string"}
      }
    }
  }
}
