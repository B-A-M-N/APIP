{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apip/indicator.schema.json",
  "title": "APIP Indicator",
  "type": "object",
  "required": [
    "id",
    "type",
    "value"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "description": "Indicator type. THIS enum is the reference runtime's loadable decision-input vocabulary (apip.io._INDICATOR_TYPES) — reconciled so schema-valid == loadable. File-hash / certificate-fingerprint / network-fingerprint indicator kinds are NOT implemented by the reference decision engine and are therefore NOT loadable input types here; they belong to the DRAFT-FUTURE control-plane contract, not the reference indicator schema (audit P1-29).",
      "enum": [
        "fqdn",
        "ipv4",
        "ipv6",
        "cidr",
        "url"
      ]
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "first_seen": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "marking": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
